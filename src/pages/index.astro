---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Kindi · Accesorios intencionados y sanación energética" current="inicio">
  <section class="home-hero">
    <svg class="hummingbird" viewBox="0 0 64 64" fill="none" stroke="#7C8A5C" stroke-width="1.4">
      <path d="M20 34c-6-2-11-8-13-14 6-1 12 2 15 7"/>
      <path d="M20 34c4-10 14-16 24-15-2 9-9 17-19 19"/>
      <circle cx="27" cy="28" r="2.2" fill="#7C8A5C" stroke="none"/>
      <path d="M25 30c-4 5-5 12-2 19 5-3 9-9 9-15"/>
      <path d="M32 33l14 6"/>
    </svg>
    <p class="brand">Kindi</p>
    <p class="tagline">Accesorios intencionados</p>
    <div class="divider"></div>
    <p class="subtext">Piezas inspiradas en la naturaleza y sesiones de sanación energética, hechas para acompañarte a brillar en equilibrio.</p>
  </section>

  <div class="home-links">
    <a class="home-card" href="/productos">
      <div class="home-card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="#4E5A38" stroke-width="1.5"><circle cx="12" cy="12" r="4"/><path d="M12 4v4M12 16v4"/></svg>
      </div>
      <h2>Productos</h2>
      <p>Cadenas, aretas, manillas y anillos, algunos con cuarzos terapéuticos.</p>
      <span class="cta">Ver catálogo →</span>
    </a>
    <a class="home-card" href="/servicios">
      <div class="home-card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="#4E5A38" stroke-width="1.5"><circle cx="12" cy="6" r="1.6"/><circle cx="12" cy="11" r="1.6"/><circle cx="12" cy="16" r="1.6"/><circle cx="12" cy="21" r="1.6"/></svg>
      </div>
      <h2>Servicios</h2>
      <p>Lecturas de tarot, limpiezas energéticas y nivelación de chakras.</p>
      <span class="cta">Ver servicios →</span>
    </a>
  </div>
</Layout>
