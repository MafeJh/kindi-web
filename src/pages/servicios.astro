---
import Layout from '../layouts/Layout.astro';
import servicios from '../data/servicios.json';

const iconos = {
  pendulo: '<path d="M12 3v4"/><circle cx="12" cy="12" r="4"/><path d="M12 16v5"/>',
  tarot: '<rect x="5" y="3" width="6" height="10" rx="1"/><rect x="13" y="7" width="6" height="10" rx="1"/>',
  chakra: '<circle cx="12" cy="6" r="1.6"/><circle cx="12" cy="11" r="1.6"/><circle cx="12" cy="16" r="1.6"/><circle cx="12" cy="21" r="1.6"/>',
  espacio: '<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/>',
  reiki: '<circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/>',
};
---
<Layout title="Servicios · Kindi" current="servicios">
  <section class="page-hero">
    <p class="brand" style="font-size:38px;">Servicios de sanación</p>
    <div class="divider"></div>
    <p class="subtext">Sesiones y lecturas guiadas con intención, para acompañarte a recuperar el equilibrio.</p>
  </section>

  <div class="wrap-narrow">
    <div class="services">
      {servicios.map(s => (
        <div class="service">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" set:html={iconos[s.tipo]}></svg>
          </div>
          <div class="service-body">
            <div class="service-top">
              <p class="service-name">{s.nombre}{s.nota && <span class="service-note">{s.nota}</span>}</p>
              <span class="service-price">{s.precio}</span>
            </div>
            <p class="service-desc">{s.descripcion}</p>
            <button class="service-btn" data-nombre={s.nombre}>Agendar</button>
          </div>
        </div>
      ))}
    </div>

    <div class="payment-section">
      <p class="section-label">Medios de pago</p>
      <div class="payment-grid">
        <div class="pay-card">
          <div class="pay-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg></div>
          <div>
            <p class="pay-label">Nequi</p>
            <p class="pay-value">319 707 9603</p>
          </div>
        </div>
        <div class="pay-card">
          <div class="pay-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.5"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg></div>
          <div>
            <p class="pay-label">Ahorros Bancolombia</p>
            <p class="pay-value">511-248-55105</p>
          </div>
        </div>
        <div class="pay-card">
          <div class="pay-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.5"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 018 0v3"/></svg></div>
          <div>
            <p class="pay-label">Llave</p>
            <p class="pay-value">@MJH729</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  document.querySelector('.services').addEventListener('click', e => {
    const btn = e.target.closest('.service-btn');
    if (!btn) return;
    const msg = 'Hola, quisiera agendar el servicio: ' + btn.dataset.nombre;
    window.open('https://wa.me/573197079603?text=' + encodeURIComponent(msg), '_blank');
  });
</script>
