---
import Layout from '../layouts/Layout.astro';
import todosLosProductos from '../data/productos.json';

// Ocultar piezas sin foto hasta que se entregue la imagen.
const productos = todosLosProductos.filter(p => p.imagen);

const categorias = [
  { key: 'todos', label: 'Todos', icon: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>' },
  { key: 'cadenas', label: 'Cadenas', icon: '<circle cx="9" cy="9" r="3"/><circle cx="15" cy="15" r="3"/><path d="M11 11l2 2"/>' },
  { key: 'aretas', label: 'Aretas', icon: '<path d="M12 4v4"/><circle cx="12" cy="12" r="4"/><path d="M12 16v4"/>' },
  { key: 'manillas', label: 'Manillas', icon: '<ellipse cx="12" cy="12" rx="8" ry="5"/>' },
  { key: 'anillos', label: 'Anillos', icon: '<circle cx="12" cy="14" r="6"/><path d="M9 8l3-4 3 4"/>' },
  { key: 'sets', label: 'Sets', icon: '<circle cx="9" cy="12" r="5"/><circle cx="15" cy="12" r="5"/>' },
  { key: 'dijes', label: 'Dijes', icon: '<path d="M12 3a5 5 0 015 5c0 4-5 9-5 9s-5-5-5-9a5 5 0 015-5z"/><circle cx="12" cy="8" r="1.3"/>' },
];

const catLabels = {
  cadenas: 'cadenas',
  aretas: 'aretas',
  manillas: 'manillas',
  anillos: 'anillos',
  sets: 'sets',
  dijes: 'dijes y piedras',
};

const intentIcons = {
  amor: '<path d="M12 20s-8-5-8-11a5 5 0 019-3 5 5 0 019 3c0 6-8 11-8 11z"/>',
  calma: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>',
  abundancia: '<circle cx="12" cy="12" r="7"/><path d="M12 8v8M9 11h6M9 14h6"/>',
  proteccion: '<path d="M12 3l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6z"/>',
  claridad: '<circle cx="12" cy="12" r="8"/><path d="M12 8v8"/>',
  vitalidad: '<path d="M12 3v18M6 8l6-5 6 5M6 16l6 5 6-5"/>',
};
---
<Layout title="Productos · Kindi" current="productos">
  <section class="page-hero">
    <p class="brand" style="font-size:38px;">Nuestros productos</p>
    <div class="divider"></div>
    <p class="subtext">Algunas piezas llevan cuarzos terapéuticos con una intención especial para acompañarte.</p>
  </section>

  <div class="wrap">
    <nav class="cat-rail" id="catRail">
      {categorias.map((cat, i) => (
        <button class={`cat-item ${i === 0 ? 'active' : ''}`} data-cat={cat.key}>
          <span class="cat-circle"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" set:html={cat.icon}></svg></span>
          <span class="cat-label">{cat.label}</span>
        </button>
      ))}
    </nav>

    <div class="toolbar">
      <div class="search-box">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg>
        <input type="text" id="searchInput" placeholder="Buscar por nombre o intención..." />
      </div>
    </div>

    <p class="count-line" id="countLine">{productos.length} piezas</p>

    <div class="grid" id="grid">
      {productos.map(p => (
        <div class="card" data-cat={p.categoria} data-search={`${p.nombre} ${p.descripcion} ${p.intencion || ''} ${p.variantes ? p.variantes.map(v => `${v.nombre} ${v.descripcion || ''}`).join(' ') : ''}`.toLowerCase()}>
          <div class="thumb" style={`background:${p.intencion ? 'var(--sage-pale)' : 'var(--gold-pale)'}`}>
            {p.intencion && <div class="intent-chip">{p.intencion}</div>}
            {p.imagen ? (
              <img src={p.imagen} alt={p.nombre} loading="lazy" />
            ) : (
              <svg viewBox="0 0 24 24" fill="none" stroke={p.intencion ? '#4E5A38' : '#8a6f3a'} stroke-width="1.3" set:html={p.intencion ? intentIcons[p.intencion] : '<circle cx="12" cy="12" r="8"/>'}></svg>
            )}
          </div>
          <div class="card-body">
            <div class="card-cat">{catLabels[p.categoria] || p.categoria}</div>
            <p class="card-name">{p.nombre}</p>
            <p class="card-desc">{p.descripcion}</p>
            {p.variantes ? (
              <div class="variant-list">
                {p.variantes.map(v => (
                  <div class="variant-row">
                    <div class="variant-info">
                      <span class="variant-name">{v.nombre}</span>
                      <span class="variant-price">{v.precio}</span>
                    </div>
                    <button class="variant-btn" data-nombre={`${p.nombre} - ${v.nombre}`}>Consultar</button>
                  </div>
                ))}
              </div>
            ) : (
              <div class="card-footer">
                <span class="card-price">{p.precio}</span>
                <button class="card-btn" data-nombre={p.nombre}>Consultar</button>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
    <div class="empty-state" id="emptyState" style="display:none;">No encontramos piezas con esa búsqueda.</div>
  </div>
</Layout>

<script>
  const catRail = document.getElementById('catRail');
  const searchInput = document.getElementById('searchInput');
  const cards = Array.from(document.querySelectorAll('#grid .card'));
  const countLine = document.getElementById('countLine');
  const emptyState = document.getElementById('emptyState');
  let activeCat = 'todos';
  let query = '';

  function applyFilter() {
    let visible = 0;
    cards.forEach(card => {
      const catOk = activeCat === 'todos' || card.dataset.cat === activeCat;
      const q = query.trim().toLowerCase();
      const qOk = !q || card.dataset.search.includes(q);
      const show = catOk && qOk;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    countLine.textContent = visible + (visible === 1 ? ' pieza' : ' piezas');
    emptyState.style.display = visible === 0 ? 'block' : 'none';
  }

  catRail.addEventListener('click', e => {
    const btn = e.target.closest('.cat-item');
    if (!btn) return;
    document.querySelectorAll('.cat-item').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    activeCat = btn.dataset.cat;
    applyFilter();
  });

  searchInput.addEventListener('input', e => {
    query = e.target.value;
    applyFilter();
  });

  document.getElementById('grid').addEventListener('click', e => {
    const btn = e.target.closest('.card-btn, .variant-btn');
    if (!btn) return;
    const msg = 'Hola, me interesa la pieza ' + btn.dataset.nombre;
    window.open('https://wa.me/573197079603?text=' + encodeURIComponent(msg), '_blank');
  });
</script>